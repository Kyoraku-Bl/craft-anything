{
  "headers": [
    {
      "source": "/DimaLingo-Android.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"DimaLingo-Android.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|DimaLingo-Android\\.apk|manifest\\.webmanifest|sw\\.js|icon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
